# fetched sources, local secrets, run output: the directories are kept
# (each has a README.md placeholder), their contents are ignored
.cache/*
!.cache/README.md
.local/*
!.local/README.md
out/*
!out/README.md
*-ctx/
**/bin/

# audio and bitstreams are never committed
*.pcm
*.bin
*.wav
*.raw
*.frames

# python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
