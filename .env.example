# dv-testset pins and settings (tracked). Copy to .env to override locally:
#   cp .env.example .env
# Load order (later wins): .env.example, .env, .local/rig.env (secrets only);
# a variable already set in the calling shell wins over all files.
# Format: KEY=value, one per line, no quotes needed, no inline comments.
# Never put a secret here; scripts/gen-local.sh writes them to .local/rig.env.

# ---- compose ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=dvt
# Rig network /24 prefix; DVT_SUBNET (a /24 like 172.30.0.0/24), when set, wins
DVT_NET=172.30.0
DVT_SUBNET=

# ---- transcoders (user supplied, local only) -------------------------------
# TRANSCODER_IMAGE=<your-ambed-image>
TRANSCODER_IMAGE=
# Per-side overrides; empty = TRANSCODER_IMAGE
TRANSCODER_REF_IMAGE=
TRANSCODER_SUT_IMAGE=
# Local compose override that maps DVT_TRANSCODER_BIND/PEERS to your image's
# own variables or arguments (see rig/transcoder.example.yml); used when it exists
TRANSCODER_COMPOSE=.local/transcoder.yml

# ---- xlxd sources (scripts/pre-fetch-xlxd.sh) ------------------------------
# Reference: upstream master, pinned. A full 40-hex commit is verified.
XLXD_REF_REPO=https://github.com/LX3JL/xlxd
XLXD_REF_COMMIT=a978f03671d87c6d9ac13453689755991e5cb668
# System under test; empty = same as the reference.
# Example: XLXD_SUT_REPO=https://github.com/<owner>/xlxd  XLXD_SUT_REF=<branch or commit>
XLXD_SUT_REPO=
XLXD_SUT_REF=
# .cache/xlxd/<dir> trees built as xlxd-ref / xlxd-sut
XLXD_REF_DIR=ref
XLXD_SUT_DIR=sut

# ---- codec2 for the tester (scripts/pre-fetch-codec2.sh) -------------------
# release 1.2.0
CODEC2_REPO=https://github.com/drowe67/codec2
CODEC2_COMMIT=06d4c11e699b0351765f10398abb4f663a984f36

# ---- NXDNReflector for the nxdn profile (scripts/pre-fetch-nxdn.sh) --------
# g4klx/NXDNClients (GPL-2.0): last commit that still has NXDNReflector/
# (removed upstream in 486106a9, 2023-02-23)
NXDNCLIENTS_REPO=https://github.com/g4klx/NXDNClients
NXDNCLIENTS_COMMIT=3bc2a1415b1a4454abd8622e59631bbe781fefc7
NXDN_BASE_IMAGE=debian:bookworm-slim
# NXDN talkgroup of both reflectors and the xlxd module peered with it
DVT_NXDN_TG=31672
DVT_NXDN_MODULE=F

# ---- base images (a tag, or name@sha256:<digest> to pin exactly) -----------
XLXD_BASE_IMAGE=debian:bookworm-slim
TESTER_BASE_IMAGE=python:3.12-slim-bookworm
ALLSTAR_BASE_IMAGE=debian:trixie-slim
# pytest installed in the tester image
PYTEST_VERSION=9.2.0

# ---- AllStarLink 3 (rig/Dockerfile.allstar) --------------------------------
# apt repository package, verified with sha256sum -c before install
ASL_REPO_DEB_URL=https://repo.allstarlink.org/public/asl-apt-repos.deb13_all.deb
ASL_REPO_DEB_SHA256=22ae4334fc8780f105c33c0017ff4e2663198d3b52d977db48949a5a732889d5
# Exact Debian version of asl3-asterisk, -config and -modules; empty = latest
ASL3_ASTERISK_VERSION=2:22.10.1+asl3-3.10.8-1.deb13

# ---- packet capture (run.sh --capture, scripts/tshark.sh) -----------------
CAPTURE_BASE_IMAGE=debian:trixie-slim
# Exact Debian version of tshark and wireshark-common; empty = latest
TSHARK_VERSION=4.4.19-0+deb13u1
# Per-sniffer pcapng size cap in kB (dumpcap stops at it); up to 4 sniffers
CAPTURE_FILESIZE_KB=49152

# ---- later downloads: NAME_URL + NAME_SHA256, fetched with fetch_verified --
# (scripts/lib/env.sh) into .cache/; examples, not used yet:
# TV_ZIP_URL=
# TV_ZIP_SHA256=
