# SPDX-License-Identifier: MIT
# mrefd (n7tae/mrefd, GPL-3.0), the M17 Project reflector, built from fetched
# source (scripts/pre-fetch-mrefd.sh), passed in as the named build context
# "src" (.cache/mrefd). Built without DHT (DHT=false: no OpenDHT, no libcurl,
# no network lookups). Build arg MREFD_BASE_IMAGE from .env.example.
ARG MREFD_BASE_IMAGE
FROM ${MREFD_BASE_IMAGE} AS build
ARG MAKE_JOBS=4
RUN apt-get update && apt-get install -y --no-install-recommends g++ make libc6-dev nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=src Makefile example.mk /src/
COPY --from=src *.cpp *.h /src/
RUN sed -e 's/^DHT *=.*/DHT = false/' -e 's/^DEBUG *=.*/DEBUG = false/' /src/example.mk > /src/mrefd.mk \
    && make -C /src -j"${MAKE_JOBS}" mrefd

FROM ${MREFD_BASE_IMAGE}
COPY --from=build /src/mrefd /mrefd/mrefd
COPY mrefd-entry.sh /mrefd/entry.sh
RUN chmod 755 /mrefd/entry.sh
ENTRYPOINT ["/mrefd/entry.sh"]
