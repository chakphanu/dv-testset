# SPDX-License-Identifier: MIT
# DStarGateway settings of the rig's hotspot (rig/mmdvmstack-entry.sh fills in the placeholders).
# One homebrew repeater (module B) that MMDVMHost drives on loopback, linked at start to XRF<num> module <letter>
# over DExtra (no authentication server, no internet). No ircDDB section (ircDDB off), no APRS, no remote, no
# DPlus (it logs in to an authentication server), no DCS, no XLX, no host file download (every URL is empty),
# no audio files (no spoken announcements), no log file (the console is the only log target).

[Gateway]
type=hotspot
callsign=@CALLSIGN@
address=@LOCAL_ADDR@
hbAddress=127.0.0.1
hbPort=20010
latitude=0.0
longitude=0.0
description1=
description2=
url=
language=english_uk

[Repeater_1]
enabled=true
band=B
callsign=@CALLSIGN@
address=127.0.0.1
port=20011
type=hb
reflector=XRF@REFLECTOR_NUM@ @MODULE_DSTAR@
reflectorAtStartup=true
reflectorReconnect=fixed
frequency=438.8
offset=0.0
rangeKm=1
latitude=0.0
longitude=0.0
agl=0
description1=
description2=
url=

[APRS]
enabled=false

[Log]
path=/tmp/mmdvm/dgwlog/
fileRoot=dstargateway
fileRotate=false
fileLevel=none
displayLevel=@DSTARGW_LOG_LEVEL@
repeatThreshold=disabled

[Paths]
data=/tmp/mmdvm/

[HostsFiles]
downloadedHostsFiles=/tmp/mmdvm/
customHostsfiles=/tmp/mmdvm/custom/
downloadTimer=72

[DExtra]
enabled=true
maxDongles=5
hostfileUrl=

[DPlus]
enabled=false
maxDongles=5
hostfileUrl=

[DCS]
enabled=false
hostfileUrl=

[XLX]
enabled=false
hostfileUrl=

[DRats]
enabled=false

[Remote]
enabled=false

[AccessControl]
whiteList=
blackList=
restrictList=

[Daemon]
daemon=false
