; SPDX-License-Identifier: MIT
; IAX2 side of one asl-lab node. Modelled on the ASL3 default iax.conf
; (asl3-asterisk-config 3.10.8): same codecs, jitterbuffer and [radio] user.
; Tokens are filled by dvt-asl-lab-entry: @PORT@ (DVT_ASL_IAX_PORT, default
; 4569), @ACCT_SECRET@ (fixture, not a real credential).
[general]
bindaddr = 0.0.0.0
bindport = @PORT@
disallow = all
allow = ulaw
allow = adpcm
allow = gsm
jitterbuffer = yes
forcejitterbuffer = yes
dropcount = 2
maxjitterbuffer = 1000
maxjitterinterps = 10
resyncthreshold = 500
maxexcessbuffer = 80
minexcessbuffer = 10
jittershrinkrate = 1
tos = 0x1E
autokill = yes
delayreject = yes
maxcallnumbers_nonvalidated = 10
; registrations (REGREQ towards the lab registrar) are written here by the
; agent per scenario (empty at start, so nothing registers unasked)
#tryinclude "/etc/asterisk/dvt-register.conf"

; node-to-node links: anonymous user "radio", no secret (ASL3 default).
; requirecalltoken is NOT set: Asterisk's default applies (call token needed).
[radio]
type = user
disallow = all
allow = ulaw
allow = adpcm
allow = gsm
codecpriority = host
context = radio-secure
transfer = no

; the same user without call token (what old IAX2 clients need)
[radio-nt]
type = user
disallow = all
allow = ulaw
allow = adpcm
allow = gsm
codecpriority = host
context = radio-secure
transfer = no
requirecalltoken = no

; account user with a secret, md5 challenge (like [iaxrpt] / [iaxclient])
[acct]
type = user
auth = md5
secret = @ACCT_SECRET@
context = radio-acct
disallow = all
allow = ulaw
allow = adpcm
allow = gsm
transfer = no
requirecalltoken = no

; the same account with call token required (default)
[acct-ct]
type = user
auth = md5
secret = @ACCT_SECRET@
context = radio-acct
disallow = all
allow = ulaw
allow = adpcm
allow = gsm
transfer = no
