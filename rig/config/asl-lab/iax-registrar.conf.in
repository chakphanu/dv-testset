; SPDX-License-Identifier: MIT
; Local stand-in for the ASL IAX2 registrar (register.allstarlink.org accepts
; "register => <node>:<password>@host"). Users are the lab node numbers
; (type=friend, host=dynamic, md5 challenge) and are generated by
; dvt-asl-lab-entry from DVT_ASL_ZONE. Refresh is pinned to 180 s like the
; real service answers in the ASL manual's example. Fixture secrets only.
[general]
bindaddr = 0.0.0.0
bindport = @PORT@
disallow = all
allow = ulaw
allow = adpcm
allow = gsm
jitterbuffer = no
autokill = yes
delayreject = yes
minregexpire = 180
maxregexpire = 180
maxcallnumbers_nonvalidated = 10
